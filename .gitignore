# Ignore everything by default...
*

# ...then track only the folders we maintain.
#
# Git can't re-include a path inside an ignored directory, so each parent
# directory is un-ignored first, then its contents.

# Keep this file and the cPanel deployment config
!.gitignore
!.cpanel.yml

# Front-end assets
!/assets
!/assets/**

# Perch – only our addons (apps, templates, plugins, etc.) and page templates.
# Everything else under /perch (core, config, resources, logs) stays untracked.
!/perch
/perch/**
!/perch/addons
!/perch/addons/**
!/perch/templates
!/perch/templates/**
